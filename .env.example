# Optional — only needed if you stand up your own backend later.
# EXPO_PUBLIC_API_URL=https://api.playtolearn.app

# ----- Firebase (https://console.firebase.google.com) -----
# Public client config — safe to ship in the mobile app. Real security is
# enforced via Firestore Security Rules in the Firebase console.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# ----- Google Sign-In (OAuth client IDs from Google Cloud Console) -----
# Web client ID is required on every platform — Firebase exchanges the Google
# credential against this client. Android/iOS IDs enable the native sign-in
# dialog on those platforms; leave blank to fall back to the web flow.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# ----- PayMongo (later, when you have an account) -----
# EXPO_PUBLIC_PAYMONGO_PUBLIC_KEY=pk_test_xxxxxxxxxxxx
# PAYMONGO_SECRET_KEY=sk_test_xxxxxxxxxxxx

# ----- Cloudinary (optional — Firebase Storage is used as fallback) -----
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=playtolearn_unsigned

# ----- OpenAI (later, when you wire up Cloud Functions) -----
# Lives ONLY on Firebase Cloud Functions, never in the mobile bundle.
OPENAI_API_KEY=sk-xxxxxxxxxxxx
